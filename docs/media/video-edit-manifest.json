      "retained_source_duration": 8.8,
      "tail_trim_seconds": 1.1969329999999996,
      "final_frame_hold": 12.266666666666666,
      "timeline_start": 60.56666666666667,
      "timeline_end": 81.63333333333334,
      "raw_sha256": "8fcf148bf22446c7cf1ada0f256743aa9ebbaa11a86c629eb85bb30e97027bba",
      "audio_sha256": "a7f40518bfe6215f685dc5f29e6144c0e8916f4764054bd5acfc4a960272037c"
    },
    {
      "id": "05-binding",
      "title": "Bind the observation to the XML",
      "text": "In the revised experiment, telemetry restarted while the controller kept its instance and continued successful sensor I P C in the observed windows. Imported recordings are checked against the exact X M L hash. A match does not authenticate their origin or prove a fresh execution. Switch configurations and the check is cleared or rejected. Static analysis and recorded observations stay separate.",
      "audio": "05-binding.aiff",
      "duration": 23.004671,
      "audio_duration": 23.004671,
      "raw_duration": 29.096933,
      "edited_duration": 23.733333333333334,
      "speed_factor": 0.8156644321699931,
