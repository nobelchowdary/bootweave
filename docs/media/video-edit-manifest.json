      "tail_trim_seconds": 0.0,
      "final_frame_hold": 0,
      "timeline_start": 81.63333333333334,
      "timeline_end": 105.36666666666667,
      "raw_sha256": "6671a35971bafde4a87d8bc50263f378898132e84a7f665a84e4ef8a5b4fc08e",
      "audio_sha256": "e985d5c3f03b8c7511e8d2ce1ae5d813b964ee12cd65460f7601ebab342f96c6"
    },
    {
      "id": "06-limits",
      "title": "Reject incomplete or invalid input",
      "text": "Cycles and missing prerequisites cannot pass as clean results. We also captured scoped native checks for modules, readiness, and include handling. BootWeave rejects unsupported includes rather than silently skipping them. An operation-specific S L M discrepancy remains documented. These experiments make no availability, timing, or safety-certification claim.",
      "audio": "06-limits.aiff",
      "duration": 22.755057,
      "audio_duration": 22.755057,
      "raw_duration": 21.8966,
      "edited_duration": 23.466666666666665,
