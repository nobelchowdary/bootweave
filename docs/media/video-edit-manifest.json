      "tail_trim_seconds": 0.0,
      "final_frame_hold": 7.262000333333333,
      "timeline_start": 2.8,
      "timeline_end": 19.633333333333333,
      "raw_sha256": "472a929183c458f56b158cfb933fdc7bdc38a4f7a99c219491a72af89c3d489d",
      "audio_sha256": "8a4759bd5b552846e4b9ada252a7b6f7c12a8da73642f72015462e1df1d9d150"
    },
    {
      "id": "02-regression",
      "title": "Protect a service before deployment",
      "text": "This is our authored three-service workload. The software sensor serves native Q N X messages, the controller reads samples, and telemetry is optional. Change review keeps baseline and candidate files independent. Compare the revised baseline with the risky candidate and protect the controller. The policy rejects the new session coupling and shows the exact path and changed dependency.",
      "audio": "02-regression.aiff",
      "duration": 22.347302,
      "audio_duration": 22.347302,
      "raw_duration": 47.934267,
      "edited_duration": 23.066666666666666,
      "speed_factor": 0.48121454880423364,
