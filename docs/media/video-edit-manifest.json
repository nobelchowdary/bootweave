  "segments": [
    {
      "id": "01-introduction",
      "title": "Review QNX lifecycle changes",
      "text": "BootWeave helps Q N X developers review startup changes before they reach a device. One extra configuration dependency can tie an essential controller to optional telemetry. We make that relationship visible and give code review and continuous integration an explainable check.",
      "audio": "01-introduction.aiff",
      "duration": 16.109615,
      "audio_duration": 16.109615,
      "raw_duration": 9.571333,
      "edited_duration": 16.833333333333332,
      "speed_factor": 1,
