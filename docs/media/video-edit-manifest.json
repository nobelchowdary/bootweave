      "raw_sha256": "e126252601c5b0bb4389974614247d1adb79e3755a3fd0e9c646df02302f3132",
      "audio_sha256": "8de990cd5789b49561cebb2fd48371bf7abb4b98015d8efcdd4afa3e17edc0a3"
    },
    {
      "id": "03-correction",
      "title": "Review the correction",
      "text": "Swap the revisions to review the correction. Removing the unnecessary telemetry prerequisite passes the same protected-service policy. Source fingerprints and property differences keep the decision reviewable. Static coupling remains a configuration model; the graph does not simulate a restart.",
      "audio": "03-correction.aiff",
      "duration": 17.152834,
      "audio_duration": 17.152834,
      "raw_duration": 31.317867,
